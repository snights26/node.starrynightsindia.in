VITE_API_BASE_URL=http://localhost:8080/api
VITE_GOOGLE_AUTH_ENABLED=false
# Set only when VITE_GOOGLE_AUTH_ENABLED=true. This is a public OAuth client ID,
# never an OAuth client secret.
VITE_GOOGLE_CLIENT_ID=
# Optional public presentation-data IndexedDB cache. Set false to retain the
# Phase 2 HTTP/ETag-only public data flow for troubleshooting.
VITE_PUBLIC_BROWSER_CACHE_ENABLED=true
